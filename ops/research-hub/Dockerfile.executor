FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt && useradd --uid 1000 --create-home shadow
COPY shadow_executor ./shadow_executor
USER 1000:1000
HEALTHCHECK --interval=30s --timeout=5s --start-period=90s CMD python -c "import datetime,json,pathlib; x=json.loads(pathlib.Path('/tmp/shadow-health.json').read_text()); assert x['mode']=='shadow' and x['live_dispatch'] is False and x['transmitted']==0; assert (datetime.datetime.now(datetime.timezone.utc)-datetime.datetime.fromisoformat(x['at'])).total_seconds()<180"
CMD ["python", "-m", "shadow_executor.worker"]
