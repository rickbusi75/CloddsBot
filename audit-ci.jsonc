{
  // audit-ci config — see .github/workflows/ci.yml and security.yml.
  //
  // Remaining exceptions are transitive through the Solana/crypto SDK ecosystem.
  // Remaining exceptions need individual review. Compatible transitive updates
  // should be preferred over npm's suggested wholesale SDK downgrade/upgrade.
  // In particular @grpc/grpc-js is now overridden to its patched 1.14 line;
  // its previous exceptions have been removed rather than hiding new findings.
  //
  // Re-run `npm audit --audit-level=moderate --production` periodically — when an
  // upstream SDK finally updates its own pinned deps, the corresponding entry below
  // should come out of this list, not just get silently re-added by a future audit fix.
  "moderate": true,
  "production": true,
  "allowlist": [
    // uuid — v3/v5/v6 buffer-bounds check (the v4 generator is unaffected). Verified
    // node-cron's own source only calls uuid.v4() (scheduled-task.js, storage.js).
    // The other path, @wormhole-foundation/sdk-solana's pinned rpc-websockets, has no
    // direct `uuid` reference in its own source at all — likely unused/indirect — but
    // that's not fully confirmed, so treat this allowlist entry as provisional pending
    // a closer look, not as verified-safe the way node-cron's path is.
    "GHSA-w5hq-g745-h8pq",

    // stream-json — quadratic behavior is confined to the pick/ignore/filter/replace
    // helpers. The only production consumer is jayson, which imports StreamValues and
    // Verifier instead. jayson 4.3 pins stream-json 1.x and is incompatible with the
    // patched 3.x module paths, so forcing the major would break Solana RPC parsing.
    "GHSA-528h-pc64-c93x"
  ]
}
