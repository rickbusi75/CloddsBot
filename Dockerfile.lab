FROM node:22-bookworm-slim AS builder
ENV PUPPETEER_SKIP_DOWNLOAD=true
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ git ca-certificates && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json tsconfig.json ./
COPY scripts ./scripts
RUN npm ci --legacy-peer-deps
RUN npm rebuild better-sqlite3 --build-from-source --ignore-scripts=false
COPY src ./src
RUN npm run build
FROM builder AS production-deps
RUN npm prune --omit=dev --legacy-peer-deps
FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production HOME=/data CLODDS_STATE_DIR=/data CLODDS_WORKSPACE=/data/workspace PUPPETEER_SKIP_DOWNLOAD=true
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates python3 curl chromium && rm -rf /var/lib/apt/lists/*
COPY --from=production-deps /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/package.json ./package.json
COPY public ./public
COPY ops/autonomy ./ops/autonomy
RUN mkdir -p /data /app/.transformers-cache && chown node:node /data /app/.transformers-cache
USER node
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 CMD node -e "fetch('http://127.0.0.1:18789/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "dist/cli/index.js", "start"]
